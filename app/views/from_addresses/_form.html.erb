<%= form_with(model: from_address) do |form| %>
  <% if from_address.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(from_address.errors.count, "error") %> prohibited this from_address from being saved:</h2>

      <ul>
        <% from_address.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :address, style: "display: block" %>
    <%= form.text_field :address %>
  </div>

  <div>
    <%= form.label :keystore, style: "display: block" %>
    <%= form.textarea :keystore %>
  </div>

  <div>
    <%= form.label :label, style: "display: block" %>
    <%= form.text_field :label %>
  </div>

  <div>
    <%= form.label :bnb_balance, style: "display: block" %>
    <%= form.text_field :bnb_balance %>
  </div>

  <div>
    <%= form.label :token_balances, style: "display: block" %>
    <%= form.text_field :token_balances %>
  </div>

  <div>
    <%= form.label :balance_checked_at, style: "display: block" %>
    <%= form.datetime_field :balance_checked_at %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
