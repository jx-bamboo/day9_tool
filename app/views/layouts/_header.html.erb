<header class="topbar">
  <div class="topbar-inner" data-controller="hello">
    <span class="brand-mark"><%= image_tag "logo.jpg", width: 26, class: "rounded-circle" %></span>
    <span class="brand-name">天九集团</span>
    <!--<span class="text-mute ms-2" style="font-size:12px;">批量分发终端</span>-->

    <div class="ms-auto d-flex align-items-center gap-2">
      <span class="badge-t green"><span style="width:6px;height:6px;border-radius:50%;background:var(--accent);display:inline-block;"></span> BSC 主网</span>
      <span class="text-mute d-none d-md-inline" style="font-size:11px;">RPC 已连接</span>

      <!-- Devise 用户菜单 -->
      <div class="dropdown ms-2">
        <% if user_signed_in? %>
          <button class="user-chip" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="user-avatar">A</span>
            <span class="num d-none d-sm-inline" style="font-size:11px;"><%= current_user.email %></span>
            <span style="font-size:9px; opacity:0.6;">▾</span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end" style="background:var(--bg-elev); border:1px solid var(--border-strong);">
            <!--<li><a class="dropdown-item text-dim" href="#" style="font-size:12px;">账号设置</a></li>-->
            <!--<li><a class="dropdown-item text-dim" href="#" style="font-size:12px;">修改密码</a></li>-->
            <!--<li><hr class="dropdown-divider" style="border-color:var(--border);"></li>-->
            <li>
              <%= link_to "退出登录", destroy_user_session_path(), method: :delete, class: "dropdown-item fs11 btn-t danger", data: { turbo: true, turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
            </li>
          </ul>
        <% else %>
          <%= link_to "Log in", new_user_session_path(), class: "btn btn-sm btn-outline-primary my-1 rounded-4", data: { turbo: false } %>
        <% end %>
      </div>

    </div>
  </div>
</header>
