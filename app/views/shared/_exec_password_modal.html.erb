<div class="modal fade" id="execPasswordModal" tabindex="-1"
     data-controller="password-modal"
     data-action="show.bs.modal->password-modal#onShow">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" data-password-modal-target="title">确认执行</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="text-mute" data-password-modal-target="desc" style="font-size:12px;"></p>
        <label class="form-label">执行密码</label>
        <input type="password" class="form-control" autocomplete="off"
               data-password-modal-target="password"
               data-action="keydown.enter->password-modal#confirm">
        <div class="form-text mt-1">密码仅用于本次解密私钥，不会存储。</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-t ghost" data-bs-dismiss="modal">取消</button>
        <button type="button" class="btn-t danger"
                data-password-modal-target="confirmBtn"
                data-action="click->password-modal#confirm">确认执行</button>
      </div>
    </div>
  </div>
</div>
