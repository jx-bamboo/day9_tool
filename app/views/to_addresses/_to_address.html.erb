<div id="<%= dom_id to_address %>">
  <div>
    <strong>Address:</strong>
    <%= to_address.address %>
  </div>

  <div>
    <strong>Keystore:</strong>
    <%= to_address.keystore %>
  </div>

  <div>
    <strong>Label:</strong>
    <%= to_address.label %>
