<%= form_with(model: token) do |form| %>
  <% if token.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(token.errors.count, "error") %> prohibited this token from being saved:</h2>

      <ul>
        <% token.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :symbol, style: "display: block" %>
    <%= form.text_field :symbol %>
  </div>

  <div>
    <%= form.label :contract_address, style: "display: block" %>
    <%= form.text_field :contract_address %>
  </div>

  <div>
    <%= form.label :decimals, style: "display: block" %>
    <%= form.number_field :decimals %>
  </div>

  <div>
    <%= form.label :token_type, style: "display: block" %>
    <%= form.number_field :token_type %>
  </div>

  <div>
    <%= form.label :chain_id, style: "display: block" %>
    <%= form.number_field :chain_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
