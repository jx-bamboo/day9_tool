<div id="<%= dom_id token %>">
  <div>
    <strong>Name:</strong>
    <%= token.name %>
  </div>

  <div>
    <strong>Symbol:</strong>
    <%= token.symbol %>
  </div>

  <div>
    <strong>Contract address:</strong>
    <%= token.contract_address %>
  </div>

  <div>
    <strong>Decimals:</strong>
    <%= token.decimals %>
  </div>

  <div>
    <strong>Token type:</strong>
    <%= token.token_type %>
  </div>

  <div>
    <strong>Chain:</strong>
    <%= token.chain_id %>
  </div>

</div>
