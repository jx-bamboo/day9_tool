<div id="<%= dom_id transfer %>">
  <div>
    <strong>From address:</strong>
    <%= transfer.from_address_id %>
  </div>

  <div>
    <strong>To address:</strong>
    <%= transfer.to_address_id %>
  </div>

  <div>
    <strong>Token:</strong>
    <%= transfer.token_id %>
  </div>

  <div>
    <strong>Batch:</strong>
    <%= transfer.batch_id %>
  </div>

  <div>
    <strong>Tx hash:</strong>
    <%= transfer.tx_hash %>
  </div>

  <div>
    <strong>Amount:</strong>
    <%= transfer.amount %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= transfer.status %>
  </div>

  <div>
    <strong>Error message:</strong>
    <%= transfer.error_message %>
  </div>

  <div>
    <strong>Broadcasted at:</strong>
    <%= transfer.broadcasted_at %>
  </div>

  <div>
    <strong>Confirmed at:</strong>
    <%= transfer.confirmed_at %>
  </div>

</div>
